{
  "name": "@behavior-os/cli",
  "version": "2.0.0",
  "description": "CLI for Behavior-OS initialization and management",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "behavioros": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node ../../scripts/clean.mjs"
  },
  "dependencies": {
    "@behavior-os/core": "workspace:*",
    "@behavior-os/schemas": "workspace:*",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "js-yaml": "^5.4.3"
  },
  "files": [
    "dist/"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
