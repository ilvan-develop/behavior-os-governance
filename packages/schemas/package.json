{
  "name": "@behavior-os/schemas",
  "version": "2.0.1",
  "description": "Zod schemas for Behavior-OS types",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node ../../scripts/clean.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "files": [
    "dist/"
  ],
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
