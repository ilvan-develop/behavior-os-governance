{
  "name": "@behavior-os/mcp-server",
  "version": "2.3.0",
  "description": "MCP server exposing 87 tools and 2 resources for Behavior-OS governance",
  "type": "module",
  "main": "./dist/server.js",
  "bin": {
    "behavioros-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node ../../scripts/clean.mjs"
  },
  "dependencies": {
    "@behavior-os/core": "workspace:*",
    "@behavior-os/schemas": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "js-yaml": "^5.4.3",
    "zod": "^4.4.3"
  },
  "files": [
    "dist/"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
