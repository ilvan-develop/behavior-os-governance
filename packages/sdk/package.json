{
  "name": "@behavior-os/sdk",
  "version": "2.2.2",
  "description": "High-level TypeScript SDK for Behavior-OS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node ../../scripts/clean.mjs"
  },
  "dependencies": {
    "@behavior-os/core": "workspace:*",
    "@behavior-os/schemas": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
