{
  "name": "@behavior-os/core",
  "version": "2.3.0",
  "description": "Core engine: governance, quality, audit, learning, mission, pipeline, decision and DNA engines with optional persistence",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./engine/*": {
      "import": "./dist/engine/*.js",
      "types": "./dist/engine/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node ../../scripts/clean.mjs"
  },
  "dependencies": {
    "@behavior-os/schemas": "workspace:*",
    "js-yaml": "^5.4.3"
  },
  "files": [
    "dist/"
  ],
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
