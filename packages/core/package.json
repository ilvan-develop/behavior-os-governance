{
  "name": "@behavior-os/core",
  "version": "2.0.0",
  "description": "Core engine with 22 governance, quality, and learning engines",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./engine/*": {
      "import": "./dist/engine/*.js",
      "types": "./dist/engine/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@behavior-os/schemas": "workspace:*",
    "js-yaml": "^5.4.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "typescript": "~5.9.3",
    "vitest": "^3.0.0"
  }
}
