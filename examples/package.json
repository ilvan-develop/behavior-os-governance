  "dependencies": {
    "@behavior-os/core": "workspace:*",
    "@behavior-os/schemas": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
