node_modules/
dist/
coverage/
.turbo/
*.tsbuildinfo
.DS_Store
.env
.env.local
.mcp.json
# The OpenCode project control plane is committed; only ad-hoc files stay local.
.opencode/*
!.opencode/agents/
.opencode/agents/*
!.opencode/agents/auditor.md
!.opencode/agents/planner.md
!.opencode/agents/researcher.md
!.opencode/agents/reviewer.md
!.opencode/commands/
.opencode/commands/*
!.opencode/commands/audit.md
!.opencode/commands/govern.md
!.opencode/commands/learn.md
!.opencode/commands/mission.md
!.opencode/commands/review.md
!.opencode/commands/verify.md
!.opencode/plugins/
.opencode/plugins/*
!.opencode/plugins/behavioros.ts
!.opencode/skills/
.opencode/skills/*
!.opencode/skills/behavior-os/
!.opencode/skills/docs-research/
!.opencode/skills/engineering-cycle/
!.opencode/skills/release/
!.opencode/skills/verification-first/
.claude/
.cursor/
.vscode/
.windsurf/
.roo/
.husky/_
.behavioros/baseline.json
# Control-loop runtime state (plan + state JSON written by bos_start_loop).
.behavioros/loops/
# Session logs are local evidence, not source.
.behavioros/*.log
# Pipeline-loop artefacts (SPEC/DOD/TRACE/STATE, evidence logs and captures) are
# produced by an audit session, not by the product. Biome reads .gitignore, so
# ignoring them keeps another session's evidence out of the lint gate.
.pipeline/
# Local SQLite persistence files must never be committed.
*.db
*.db-wal
*.db-shm
# Generated API documentation (typedoc `out`). Never hand-edit, never commit.
# It lives in its own directory so typedoc's cleanOutputDir cannot touch the
# hand-written docs in docs/.
docs/api/
# Guard: build artifacts must never leak into source or test directories.
# tsc targets ./dist; anything emitted next to .ts sources is stale output.
**/src/**/*.js
**/src/**/*.js.map
**/src/**/*.d.ts
**/src/**/*.d.ts.map
**/tests/**/*.js
**/tests/**/*.js.map
**/tests/**/*.d.ts
**/tests/**/*.d.ts.map
# Vitest config type-check artifacts (generated next to vitest.config.ts).
**/vitest.config.d.ts
**/vitest.config.d.ts.map
**/vitest.config.js
**/vitest.config.js.map
# Local agent session artifacts — temporary scripts, outputs, and generated summaries.
temp.txt
*.txt
*.bat
check-*.js
check-*.bat
FINAL_*.md
IMPLEMENTATION_PLAN.md
IMPLEMENTATION_SUMMARY.md
REQUIREMENTS.md
TASKS.md
fix-*.cjs
run-*.bat
run-*.cjs
test-governance*.cjs
npm-lock.yaml
# Generated npm auth file used by CI; must never be committed.
.npm-auth-tmp
status.log
