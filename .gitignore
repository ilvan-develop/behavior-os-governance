# Local SQLite persistence files must never be committed.
*.db
*.db-wal
*.db-shm
# Generated API documentation (typedoc `out`). Never hand-edit, never commit.
# It lives in its own directory so typedoc's cleanOutputDir cannot touch the
# hand-written docs in docs/.
docs/api/
# Guard: build artifacts must never leak into source or test directories.
# tsc targets ./dist; anything emitted next to .ts sources is stale output.
**/src/**/*.js
**/src/**/*.js.map
**/src/**/*.d.ts
**/src/**/*.d.ts.map
**/tests/**/*.js
**/tests/**/*.js.map
**/tests/**/*.d.ts
**/tests/**/*.d.ts.map
