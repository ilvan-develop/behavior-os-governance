{
  "name": "@behavior-os/opencode-plugin",
  "version": "2.0.0",
  "description": "OpenCode v2 plugin for Behavior-OS governance",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node ../../scripts/clean.mjs"
  },
  "dependencies": {
    "@behavior-os/core": "workspace:*",
    "@behavior-os/schemas": "workspace:*",
    "@opencode/plugin": "^2.0.0-beta.10",
    "effect": "4.0.0-rc.112",
    "js-yaml": "^5.4.3"
  },
  "files": [
    "dist/"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
