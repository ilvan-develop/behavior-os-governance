{
  "name": "behavior-os",
  "private": true,
  "version": "2.0.0",
  "description": "The Operating System for Autonomous AI Teams — Behavioral Governance Platform for AI Agent Organizations",
  "type": "module",
  "packageManager": "pnpm@10.4.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "typecheck": "turbo typecheck",
    "format": "biome format --write .",
    "clean": "turbo clean",
    "clean:all": "turbo clean && rm -rf node_modules",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepare": "husky",
    "mcp:start": "pnpm --filter @behavior-os/mcp-server start",
    "cli:init": "pnpm --filter @behavior-os/cli run init",
    "docs:build": "typedoc",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@changesets/cli": "^2.29.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@opencode/plugin": "^2.0.0-beta.10",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.4.0",
    "turbo": "^2.4.0",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.0.0",
    "typescript": "~5.9.3",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@behavior-os/core"
      ]
    },
    "overrides": {
      "@behavior-os/core": "workspace:*",
      "@behavior-os/schemas": "workspace:*"
    }
  },
  "lint-staged": {
    "*.{ts,js}": [
      "biome check --write",
      "git add"
    ],
    "*.{json,yaml,yml,md}": [
      "biome format --write",
      "git add"
    ]
  }
}
